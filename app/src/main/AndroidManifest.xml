<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Audio recording permission for acoustic monitoring -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground Service permissions (Android 9+ and Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notification permission for Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Location permissions (used by Developer 3/4 location pipeline) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Haptic feedback for emergency alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Partial wake lock to ensure real-time audio frame ingestion while armed -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ECHO"
        tools:targetApi="34">

        <!-- Main UI: Arm/Disarm and Live Acoustic Monitoring -->
        <activity
            android:name=".ui.ArmEchoActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ECHO">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Audio Service with Microphone Type (Android 14+ requirement) -->
        <service
            android:name=".audio.ForegroundAudioService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
